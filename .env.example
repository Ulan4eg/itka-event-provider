# Copy to .env for local development. NEVER commit the real .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=*

# PostgreSQL (if not set - local sqlite is used)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/events

# Events Provider API
EVENTS_PROVIDER_URL=http://events-provider.dev-2.python-labs.ru
# EVENTS_PROVIDER_API_KEY=put-your-key-from-lms-here
