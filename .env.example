# Copy to .env for local development. NEVER commit the real .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=*

# PostgreSQL for local work (if nothing is set - local sqlite is used).
# On the platform these come as POSTGRES_CONNECTION_STRING or
# POSTGRES_DATABASE_NAME / _USERNAME / _PASSWORD / _HOST / _PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/events

# Events Provider API
EVENTS_PROVIDER_URL=http://events-provider.dev-2.python-labs.ru
EVENTS_PROVIDER_API_KEY=put-your-key-from-lms-here

# Capashino (notifications). Locally use the public host; inside the cluster the
# default internal host is used. The token is on the portal profile page.
CAPASHINO_URL=https://capashino.dev-2.python-labs.ru
CAPASHINO_API_TOKEN=put-your-capashino-token-here

# Outbox worker (defaults are shown)
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL=2
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY=5
OUTBOX_RETRY_MAX_DELAY=300

# How long an idempotency key keeps returning the saved result (hours)
IDEMPOTENCY_KEY_TTL_HOURS=24

# GlitchTip (empty = error tracking is off). DSN appears after provisioning.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_DEBUG_ENDPOINT=false
